# Optional server-side OpenAI-compatible provider credentials.
# Keep the key private. Copy this file to .env and never commit .env.
PEOPLECARE_API_KEY=
PEOPLECARE_API_BASE=https://api.openai.com/v1
PEOPLECARE_MODEL=gpt-4o-mini
PEOPLECARE_PROVIDER=ollama

# Local Ollama provider. This model must already be available in Ollama.
PEOPLECARE_LOCAL_MODEL=qwen3:4b-instruct
PEOPLECARE_OLLAMA_URL=http://127.0.0.1:11434
PEOPLECARE_OLLAMA_KEEP_ALIVE=30m
PEOPLECARE_OLLAMA_TIMEOUT=120
PEOPLECARE_OLLAMA_PRELOAD=true

# Optional runtime/security settings.
PEOPLECARE_ENV=development
PEOPLECARE_HOST=127.0.0.1
PEOPLECARE_PORT=5000
# Debug is accepted only for an explicit loopback development bind. It is always disabled in production.
PEOPLECARE_DEBUG=false
PEOPLECARE_MAX_REQUEST_BYTES=1048576
PEOPLECARE_CHAT_RPM=30
PEOPLECARE_AGENT_RPM=60
PEOPLECARE_CORS_ORIGINS=
# Set a strong admin password here. It is only read by Flask.
PEOPLECARE_ADMIN_PASSWORD=
# Optional legacy setting; PEOPLECARE_ADMIN_PASSWORD takes precedence.
PEOPLECARE_ADMIN_TOKEN=
# Optional local-only demo access when neither password setting is present.
# Keep false for normal use. Enable only when Flask binds to loopback and is
# accessed directly from the same machine; never enable behind a proxy/public host.
PEOPLECARE_ADMIN_DEV_BYPASS=false
# Optional Web Push for admin phone alerts. Generate keys with scripts/generate_vapid_keys.py.
# Set these on Flask and configure the same values in your hosting provider's environment.
PEOPLECARE_VAPID_PUBLIC_KEY=
PEOPLECARE_VAPID_PRIVATE_KEY_B64=
PEOPLECARE_VAPID_SUBJECT=mailto:admin@example.com
