# For browser development, leave this blank (Vite proxies /api to Flask).
# For a deployed frontend, set this to the public Flask service origin, e.g.
# https://communitysignalai-api.onrender.com (do not add /api).
# For Android, set this to your computer's LAN IPv4 address, e.g. http://192.168.1.10:5000
VITE_API_BASE_URL=
